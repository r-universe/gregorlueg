[submodule ".registry"]
	path = .registry
	url = https://github.com/gregorlueg/gregorlueg.r-universe.dev
	branch = HEAD
[submodule "annsearchR"]
	path = annsearchR
	url = https://github.com/GregorLueg/annsearchR
	branch = v0.1.0
[submodule "bixverse"]
	path = bixverse
	url = https://github.com/GregorLueg/bixverse
	branch = v0.8.2
[submodule "bixverse.gpu"]
	path = bixverse.gpu
	url = https://github.com/GregorLueg/bixverse.gpu
	branch = v0.6.1
[submodule "bixverse.plots"]
	path = bixverse.plots
	url = https://github.com/GregorLueg/bixverse.plots
	branch = v0.3.0
[submodule "devforge"]
	path = devforge
	url = https://github.com/GregorLueg/devforge
	branch = v0.0.7
[submodule "genewalkR"]
	path = genewalkR
	url = https://github.com/GregorLueg/genewalkR
	branch = v0.2.3
[submodule "manifoldsR"]
	path = manifoldsR
	url = https://github.com/GregorLueg/manifoldsR
	branch = v0.5.0
